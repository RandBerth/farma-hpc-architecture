[Unit]
Description=Farma HPC API Gateway (FastAPI)
After=network.target postgresql.service

[Service]
User=rodrigo
Group=rodrigo
WorkingDirectory=/home/rodrigo/farma-hpc-architecture/api-gateway
EnvironmentFile=/home/rodrigo/farma-hpc-architecture/api-gateway/.env
ExecStart=/home/rodrigo/farma-hpc-architecture/api-gateway/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 4 --loop asyncio
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
